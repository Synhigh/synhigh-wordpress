msgid "Copy"
msgstr "کپی"

#: inc/enqueue.php:55
msgid "Copied!"
msgstr "کپی شد!"

#: inc/enqueue.php:56
msgid "Failed"
msgstr "ناموفق"

#: inc/enqueue.php:57
msgid "Copy code to clipboard"
msgstr "کپی کردن کد در کلیپ‌بورد"

#: inc/setting.php:32
msgid "Auto (follows visitor light/dark setting)"
msgstr "خودکار (پیروی از تنظیم روشن/تاریک بازدیدکننده)"

#: inc/setting.php:33
msgid "Dark"
msgstr "تاریک"

#: inc/setting.php:34
msgid "Light"
msgstr "روشن"

#: inc/setting.php:35
msgid "Ember"
msgstr "Ember"

