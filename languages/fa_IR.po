#. Plugin Name of the plugin
#: synhigh.php
msgid "Synhigh Code Highlighter"
msgstr "هایلایتر کد Synhigh"

#. Plugin URI of the plugin
#: synhigh.php
msgid "https://github.com/Synhigh/synhigh-wordpress"
msgstr "https://github.com/Synhigh/synhigh-wordpress"

#. Description of the plugin
#: synhigh.php
msgid ""
"Lightweight syntax highlighting with auto language detection, line numbers, "
"and a copy button."
msgstr ""
"رنگی‌ سازی استایل با تشخیص خودکار زبان، شمارهٔ خطوط و دکمهٔ کپی."

#. Author of the plugin
#: synhigh.php
msgid "Raymond Baghumian"
msgstr "رایموند باغومیان"

