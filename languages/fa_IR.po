#. Plugin Name of the plugin
#: synhigh.php
msgid "Synhigh Code Highlighter"
msgstr "هایلایتر کد Synhigh"

#. Plugin URI of the plugin
#: synhigh.php
msgid "https://github.com/Synhigh/synhigh-wordpress"
msgstr "https://github.com/Synhigh/synhigh-wordpress"

#. Description of the plugin
#: synhigh.php
msgid ""
"Lightweight syntax highlighting with auto language detection, line numbers, "
"and a copy button."
msgstr ""
"رنگی‌ سازی استایل با تشخیص خودکار زبان، شمارهٔ خطوط و دکمهٔ کپی."

#. Author of the plugin
#: synhigh.php
msgid "Raymond Baghumian"
msgstr "رایموند باغومیان"

#: inc/enqueue.php:54
msgid "Copy"
msgstr "کپی"

#: inc/enqueue.php:55
msgid "Copied!"
msgstr "کپی شد!"

#: inc/enqueue.php:56
msgid "Failed"
msgstr "ناموفق"

#: inc/enqueue.php:57
msgid "Copy code to clipboard"
msgstr "کپی کردن کد در کلیپ‌بورد"

#: inc/setting.php:32
msgid "Auto (follows visitor light/dark setting)"
msgstr "خودکار (پیروی از تنظیم روشن/تاریک بازدیدکننده)"

#: inc/setting.php:33
msgid "Dark"
msgstr "تاریک"

#: inc/setting.php:34
msgid "Light"
msgstr "روشن"

#: inc/setting.php:35
msgid "Ember"
msgstr "Ember"

#: inc/setting.php:93 inc/setting.php:94 inc/setting.php:119
msgid "Code Highlighter"
msgstr "هایلایتر کد"

#: inc/setting.php:124
msgid "Theme"
msgstr "پوسته"

#: inc/setting.php:134
msgid "Features"
msgstr "امکانات"

#: inc/setting.php:138
msgid "Show line numbers"
msgstr "نمایش شمارهٔ خطوط"

#: inc/setting.php:140
msgid "Show a copy button"
msgstr "نمایش دکمهٔ کپی"

#: inc/setting.php:142
msgid "Show the language label"
msgstr "نمایش برچسب زبان"

#: inc/setting.php:144
msgid "Detect the language automatically when no class is set"
msgstr "تشخیص خودکار زبان هنگامی که کلاسی تنظیم نشده باشد"

#: inc/setting.php:150
msgid "Loading"
msgstr "بارگذاری"

#: inc/setting.php:154
msgid "Load on every page"
msgstr "بارگذاری در همهٔ برگه‌ ها"

#: inc/setting.php:154
msgid ""
"By default the scripts load only on pages whose content contains a code "
"block."
msgstr ""
"به‌طور پیش‌ فرض، اسکریپت‌ ها فقط در برگه‌ هایی بارگذاری می‌شوند که محتوای "
"آنها شامل یک بلوک کد باشد."

#: inc/setting.php:156
msgid "Watch for content added after page load"
msgstr "رصد محتوای افزوده‌ شده پس از بارگذاری برگه"

#: inc/setting.php:156
msgid "Needed for infinite scroll or AJAX page transitions."
msgstr "برای پیمایش بی‌ نهایت یا جابه‌جایی برگه ‌ها با ایجکس لازم است."

#: inc/setting.php:162
msgid "Custom CSS"
msgstr "استایل سفارشی"

#: inc/setting.php:166
msgid "Override any color for every theme using CSS variables, for example:"
msgstr ""
"هر رنگی را برای همهٔ پوسته ‌ها با استفاده از متغیرهای CSS بازنویسی کنید، "
"برای مثال:"

#: inc/setting.php:175
msgid "Usage"
msgstr "روش استفاده"

#: inc/setting.php:176
msgid ""
"Add a Code block, then enter a class such as language-php in the block's "
"Advanced > Additional CSS class field. Without a class, the language is "
"detected automatically. Use the class nohighlight to skip a block."
msgstr ""
"یک بلوک کد اضافه کنید، سپس کلاسی مانند language-php را در فیلد «پیشرفته > "
"کلاس CSS اضافیِ» بلوک وارد کنید. بدون کلاس، زبان به‌ طور خودکار تشخیص داده "
"می‌شود. برای نادیده گرفتن یک بلوک، از کلاس nohighlight استفاده کنید."